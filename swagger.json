{
  "swagger": "2.0",
  "info": {
    "title": "My API",
    "description": "Fitness API",
    "version": "1.0.0"
  },
  "host": "https://cse341-personal-project-nxq4.onrender.com",
  "basePath": "/",
  "tags": [
    {
      "name": "users",
      "description": "Operations about users"
    },
    {
      "name": "workoutSessions",
      "description": "Operations about workoutSessions"
    }
  ],
  "schemes": [
    "http"
  ], 
  "securityDefinitions": {
      "myOAuth": {
        "type": "oauth2",
        "description": "This API uses OAuth 2 with the password grant flow",
        "flow": "password",
        "tokenUrl": "/oauth/token",
        "scopes": {
          "read_users": "Read your own user data",
          "write_users": "Write your own user data",
          "read_workoutSessions": "Read your own workout sessions",
          "write_workoutSessions": "Write your own workout sessions",
          "admin": "Read and write data that does not belong to you"
        }
      }
  },
  "components": {
    "schema": {
      "users": 
      {
          "type": "object",
          "required": ["userName", "firstName", "lastName", "email", "password", "age", "weight"],
          "properties": {
            "userName": {
              "type": "string"
            },
            "firstName": {
              "type": "string"
            },
            "lastName": {
              "type": "string"
            },
            "email": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "age": {
              "type": "number"
            },
            "weight": {
              "type": "number"
            }
          }
        },
        "workoutSessions": 
        {
          "type": "object",
          "required": ["user", "date", "exercise", "duration", "weight", "exertion"],
          "properties": {
            "user": {
              "type": "string"
            },
            "date": {
              "type": "string"
            },
            "exercise": {
              "type": "string"
            },
            "duration": {
              "type": "string"
            },
            "weight": {
              "type": "number"
            },
            "exertion": {
              "type": "number"
            }
          }
        }
      }
    },
  "paths": {
    "/api-docs": {
      "get": {
        "description": "",
        "responses": {
          "default": {
            "description": ""
          }
        }
      }
    },
    "/users/": {
      "get": {
        "tags": ["users"],
        "summary": "Get all users",
        "description": "This is to get all the users currently in the database",
        "security": [{"myOAuth": ["admin"]}],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "post": {
        "tags": ["users"],
        "summary": "Create new user",
        "description": "This is to create a new user in the database",
        "security": [{
          "myOAuth": ["admin"]
        }],
        "parameters": [
          {
          "name": "body",
          "in": "body",
          "schema": {
              "$ref": "#/components/schema/users"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successfully created new user"
          },
          "500": {
            "description": "An error occured"
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["users"],
        "summary": "Get one user by id number",
        "description": "This is to get one of the users currently in the database",
        "security": [{
          "myOAuth": ["admin"]
        }],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "put": {
        "tags": ["users"],
        "summary": "Edit one user",
        "description": "This is to edit one of the users currently in the database",
        "security": [{
          "myOAuth": ["admin"]
        }],
        "parameters": [
          {
            "name": "id", 
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/components/schema/users"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "delete": {
        "tags": ["users"],
        "summary": "Delete one user",
        "description": "This is to delete a single user out of the database",
        "security": [{
          "myOAuth": ["admin"]
        }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion successful"
          },
          "500": {
            "description": "An error occured"
          }
        }
      }
    },

  "/workoutSessions/": {
      "get": {
        "tags": ["workoutSessions"],
        "summary": "Get all workout sessions for self",
        "description": "This is to retrieve all of the workout sessions currently in the database",
        "security": [{
          "myOAuth": ["read_workoutSessions"]
        }],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "post": {
        "tags": ["workoutSessions"],
        "summary": "Create new workout session",
        "description": "This is to create a new workout sessions and save it in the database",
        "security": [{
          "myOAuth": ["write_workoutSessions"]
        }],
        "parameters": [
          {
          "name": "body",
          "in": "body",
          "schema": {
              "$ref": "#/components/schema/workoutSessions"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successfully created new workout session"
          },
          "500": {
            "description": "An error occured"
          }
        }
      }
    },
    "/workoutSessions/{id}": {
      "get": {
        "tags": ["workoutSessions"],
        "summary": "Get one workout session by id number",
        "description": "This is to retrieve one of the workout sessions currently in the database",
        "security": [{
          "myOAuth": ["read_workoutSessions"]
        }],
        "produces": [
          "application/json"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "put": {
        "tags": ["workoutSessions"],
        "summary": "Edit one workout session",
        "description": "This is to edit one of the workout sessions currently in the database",
        "security": [{
          "myOAuth": ["write_workoutSessions"]
        }],
        "parameters": [
          {
            "name": "id", 
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/components/schema/workoutSessions"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful operation"
          },
          "500": {
            "description": "An error occured"
          }
        }
      },
      "delete": {
        "tags": ["workoutSessions"],
        "summary": "Delete one workout session",
        "description": "This is to delete one of the workout sessions currently in the database",
        "security": [{
          "myOAuth": ["write_workoutSessions"]
        }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion Successful"
          },
          "500": {
            "description": "An error occured"
          }
        }
      }
    }
  }
}